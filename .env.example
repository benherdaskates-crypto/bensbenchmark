# Copy this file to ".env" and fill it in. The server reads it automatically.
# Everything here is optional: without it the site still works, and game
# requests are stored in data/db.json instead of being emailed.

# Port the site runs on
PORT=3000

# --- Game requests by email (set this up whenever you like) ---
# Where the "Request a game" form sends to
REQUEST_EMAIL=you@example.com

# SMTP details for the account doing the sending.
# Gmail: host smtp.gmail.com, port 587, and an App Password (not your normal one).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=BensBenchmark <youraccount@gmail.com>

# --- Admin ---
# Read every request at /api/requests?key=THIS
ADMIN_KEY=change-me

# Set to "production" when hosting over HTTPS so cookies are marked secure
# NODE_ENV=production
